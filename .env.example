# EmailJS (contact form + thank-you emails)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
# Legacy / artist notification template (new subscriber / new order alerts to you)
REACT_APP_EMAILJS_TEMPLATE_ID=
# Optional dedicated contact form template (falls back to TEMPLATE_ID)
REACT_APP_EMAILJS_CONTACT_TEMPLATE_ID=
# Subscriber thank-you (paste email-templates/subscribe-thank-you.html in EmailJS)
REACT_APP_EMAILJS_SUBSCRIBE_TEMPLATE_ID=
# Purchase thank-you (paste email-templates/purchase-thank-you.html in EmailJS)
REACT_APP_EMAILJS_PURCHASE_TEMPLATE_ID=
# Optional artist notify templates (fall back to TEMPLATE_ID)
REACT_APP_EMAILJS_SUBSCRIBE_NOTIFY_TEMPLATE_ID=
REACT_APP_EMAILJS_PURCHASE_NOTIFY_TEMPLATE_ID=

# Stripe Checkout (server-side secret — set in Vercel Environment Variables)
# Create keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Optional publishable key if you later add Stripe.js Elements
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Public site URL used for product images on Stripe Checkout (must be HTTPS reachable by Stripe)
SITE_URL=https://www.doarti.com
